NODES_DIR=../src/neuroworkflow/nodes

# Absolute path (add a path to your cloned repository (local folder django-project))
HOST_PROJECT_PATH=/home/ubuntu/brain/neuro-workflow/gui/workflow_backend/django-project

OPENAI_API_KEY="sk-xxx"
OPENAI_MODEL="gpt-5-mini"
# Set to "none" for gpt-5.6 family models (function tools require reasoning
# off on chat completions). Leave empty for gpt-5-mini / gpt-4o.
OPENAI_REASONING_EFFORT=""

# Real Anthropic key for the in-notebook Claude agent. Stays on the backend and
# powers the /api/chat/anthropic proxy; never exposed inside user kernels.
ANTHROPIC_API_KEY="sk-ant-xxx"
# Optional model override for the notebook agent (empty = CLI default).
ANTHROPIC_MODEL=""

JUPYTERHUB_API_TOKEN=dev-token-change-in-production

# --- bm_mindsdb (mdb) dataset metadata catalog ---
# Built from a sibling clone by default:
#   git clone https://github.com/oist/bm_mindsdb  # next to neuro-workflow/
# MDB_CONTEXT=../../bm_mindsdb
# Set MDB_IMAGE to skip the build and use a prebuilt image instead.
# MDB_IMAGE=mdb:latest
# Internal URL used by the backend and by kernels. The default matches the
# compose service name; change it only to point at an mdb outside compose.
# MDB_BASE_URL=http://mdb:8004
# MDB_TIMEOUT=30
