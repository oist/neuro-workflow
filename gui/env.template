NODES_DIR=../src/neuroworkflow/nodes

# Absolute path (add a path to your cloned repository (local folder django-project))
HOST_PROJECT_PATH=/home/ubuntu/brain/neuro-workflow/gui/workflow_backend/django-project

# Port binding: set to 0.0.0.0 for local dev, leave unset (defaults to
# 127.0.0.1) on a public app server where nginx is the public entry point.
# BIND_HOST=0.0.0.0

OPENAI_API_KEY="sk-xxx"
OPENAI_MODEL="gpt-5-mini"
# Reasoning effort for reasoning models, e.g. "low" for gpt-6.1-sol or "none"
# for gpt-5.6. Leave empty for gpt-4o, which rejects the parameter.
OPENAI_REASONING_EFFORT=""

# Optional: MiniMax models users can switch to in the browser chat and the
# notebook agent. Leave the key empty to hide them. MINIMAX_MODELS is a
# comma-separated list (default: MiniMax-M3). The key stays on the backend.
MINIMAX_API_KEY=""
MINIMAX_MODELS="MiniMax-M3"

# Real Anthropic key for the in-notebook Claude agent. Stays on the backend and
# powers the /api/chat/anthropic proxy; never exposed inside user kernels.
ANTHROPIC_API_KEY="sk-ant-xxx"
# Optional model override for the notebook agent (empty = CLI default).
ANTHROPIC_MODEL=""

JUPYTERHUB_API_TOKEN=dev-token-change-in-production
# Two shared Labs: project (codes/) and community (codes-hackathon/ by default).
# The Hub container cannot see host folders, so it never switches to a new
# community folder by itself. To use one, set HOST_COMMUNITY_PATH to its
# absolute host path and recreate the Hub. The API uses the same variable's
# directory name (for example codes-hackathon), so projects are created in
# the folder the Lab mounts.
# JUPYTERHUB_AUTHENTICATOR=spaces
# JUPYTERHUB_ALLOWED_USERS=internal,external,user1
# JUPYTERHUB_PROJECT_USER=internal
# JUPYTERHUB_COMMUNITY_USER=external
# JUPYTERHUB_PROJECT_PASSWORD=  (set on the server, do not commit)
# JUPYTERHUB_COMMUNITY_PASSWORD=  (set on the server, do not commit)
# HOST_COMMUNITY_PATH=/path/to/django-project/codes-hackathon
# HOST_HACKATHON_PATH is an alias for HOST_COMMUNITY_PATH.
# See deployment/JUPYTER_TWO_SPACES.md. Per-Lab resource limits:
# JUPYTER_MEM_LIMIT=8G
# JUPYTER_CPU_LIMIT=4
# JUPYTER_GRANT_SUDO=no

# mdb catalog (MDB_BASE_URL, MDB_API_TOKEN) goes in workflow_backend/.env,
# never in this Compose-level file and never as VITE_*.

# Keycloak admin credentials (default admin/admin; change for production!)
# KEYCLOAK_ADMIN=admin
# KEYCLOAK_ADMIN_PASSWORD=<strong-password>
# KEYCLOAK_DB_PASSWORD=<strong-password>
